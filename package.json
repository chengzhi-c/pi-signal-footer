{
  "name": "pi-signal-footer",
  "version": "0.2.3",
  "type": "module",
  "description": "A readable status footer for Pi Coding Agent: model, tokens, cache, cost, context bar, streaming rate, and MCP/LSP status.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhi-c/pi-signal-footer.git"
  },
  "bugs": {
    "url": "https://github.com/chengzhi-c/pi-signal-footer/issues"
  },
  "homepage": "https://github.com/chengzhi-c/pi-signal-footer#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "format.ts",
    "index.ts"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "statusline",
    "tui"
  ],
  "scripts": {
    "test": "tsx --test test/format.test.ts test/index.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
